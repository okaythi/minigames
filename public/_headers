/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.nixlabs.tech 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; img-src 'self' data: blob: https: https://*.pages.dev https://*.r2.cloudflarestorage.com https://*.nixlabs.tech; connect-src 'self' https://*.pages.dev https://*.nixlabs.tech data: blob:; font-src 'self' https://fonts.gstatic.com data:; media-src 'self' data: blob:;

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/images/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/favicon.svg
  Cache-Control: public, max-age=86400

/games/card-jitsu/*.swf
  Cache-Control: no-cache, no-store, must-revalidate
