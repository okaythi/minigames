// Cloudflare Pages configuration.
// Docs: https://developers.cloudflare.com/pages/
//
// The D1 database backs the global counters and the unique-player count:
// `game_stats` (one row per game) and `players` (one row per anonymous
// visitor). Create it with `npm run db:create` and paste the printed
// database_id below; the schema comes from ./migrations.
//
// Without the binding the Pages Function still answers, from memory, and
// reports `distributed: false` - so a preview deploy or a bare `pages dev`
// never 500s and never shows a fake global number.
{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "nixlabs-games",
  "compatibility_date": "2026-08-01",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "NIXLABS_DB",
      "database_name": "nixlabs-games",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
