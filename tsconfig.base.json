{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "checkJs": false,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@nixlabs/game-core": [
        "./packages/game-core/src/index.ts",
        "./node_modules/@nixlabs/game-core/src/index.ts"
      ],
      "@nixlabs-games/avoid-the-spikes": [
        "../game-avoid-the-spikes/src/index.ts",
        "./node_modules/@nixlabs-games/avoid-the-spikes/src/index.ts"
      ],
      "@nixlabs-games/pong": [
        "../game-pong/src/index.ts",
        "./node_modules/@nixlabs-games/pong/src/index.ts"
      ],
      "@nixlabs-games/fl-tron-3": [
        "../game-fl-tron-3/src/index.ts",
        "./node_modules/@nixlabs-games/fl-tron-3/src/index.ts"
      ],
      "@nixlabs-games/tetris": [
        "../game-tetris/src/index.ts",
        "./node_modules/@nixlabs-games/tetris/src/index.ts"
      ],
      "@nixlabs-games/blackjack-21": [
        "../game-blackjack-21/src/index.ts",
        "./node_modules/@nixlabs-games/blackjack-21/src/index.ts"
      ],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"]
    },
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictBuiltinIteratorReturn": true,
    "target": "ES2024",
    "useDefineForClassFields": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  }
}